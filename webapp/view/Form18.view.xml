<mvc:View
    controllerName="com.nhpc.zsdtarifformss1.controller.Form18"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    class="sapUiSizeCompact"
>
    <App id="idReportApp18">
        <pages>
            <Page
                id="idReportPage18"
                showHeader="false"
            >
                <content>
                    <uxap:ObjectPageLayout
                        id="idReportObjectPageLayout18"
                        upperCaseAnchorBar="false"
                    >
                        <uxap:headerTitle>
                            <uxap:ObjectPageDynamicHeaderTitle
                                id="idReportObjectPageDynamicHeaderTitle18"
                            >
                                <uxap:expandedHeading>
                                    <HBox
                                        id="idReportObjectPageExpandedHeading18"
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            id="idReportObjectPageExpandedHeadingAvatar18"
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox
                                            id="idReportObjectPageExpandedHeadingVBox18"
                                            class="sapUiTinyMarginBegin"
                                        >
                                            <Title
                                                id="objPageHeader18"
                                                text="{i18n>ObjectPageTitle} - {viewModel>/Header/Tariff_ID}"
                                                wrapping="true"
                                            />
                                            <HBox >
                                            <ObjectStatus
                                                title="{i18n>Form}"
                                                text="18"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{viewModel>/Header/Status}"
                                                class="sapMObjectStatusMedium statusBoldText sapUiSmallMarginBegin"
                                                state="{path:'viewModel>/Header/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                             <ObjectStatus
                                                title="{i18n>formStatus}"
                                                text="{viewModel>/Status}"
                                                class="sapMObjectStatusMedium statusBoldText sapUiSmallMarginBegin"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </uxap:expandedHeading>
                                <uxap:snappedHeading>
                                    <HBox
                                        id="idReportObjectPageSnappedHeading18"
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar
                                            id="idReportObjectPageSnappedHeadingAvatar18"
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox
                                            id="idReportObjectPageSnappedHeadingVBox18"
                                            class="sapUiTinyMarginBegin"
                                        >
                                            <Title
                                                id="objPageHeadersnapped18"
                                                text="{i18n>ObjectPageTitle} - {viewModel>/Header/Tariff_ID}"
                                                wrapping="true"
                                            />
                                            <HBox >
                                            <ObjectStatus
                                                title="{i18n>Form}"
                                                text="18"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                            <ObjectStatus
                                                title="{i18n>status}"
                                                text="{viewModel>/Header/Status}"
                                                class="sapMObjectStatusMedium statusBoldText sapUiSmallMarginBegin"
                                                state="{path:'viewModel>/Header/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                             <ObjectStatus
                                                title="{i18n>formStatus}"
                                                text="{viewModel>/Status}"
                                                class="sapMObjectStatusMedium statusBoldText sapUiSmallMarginBegin"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </uxap:snappedHeading>
                            </uxap:ObjectPageDynamicHeaderTitle>
                        </uxap:headerTitle>
                        <uxap:headerContent>
                            <FlexBox
                                id="idReportObjectPageHeaderContent18"
                                fitContainer="true"
                                wrap="Wrap"
                            />
                        </uxap:headerContent>
                        <uxap:sections>
                            <uxap:ObjectPageSection
                                id="idReportObjectPageSectionGeneral18"
                                title="{i18n>generalDetails}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="idReportObjectPageSubSectionGeneral18"
                                    >
                                        <uxap:blocks>
                                            <VBox
                                                id="idReportObjectPageSubSectionGeneralVBox18"
                                            >
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.sections.GeneralInfo"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection
                                id="idReportObjectPageSectionForm18Details18"
                                title="{i18n>Form18Details}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="idReportObjectPageSubSectionForm18Details18"
                                    >
                                        <uxap:blocks>
                                            <VBox
                                                id="idReportObjectPageSubSectionForm18DetailsVBox18"
                                            >
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Form18.Form18Table"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>

                            <!-- Remarks Section -->
                            <uxap:ObjectPageSection
                                id="idReportObjectPageSectionForm18Remarks18"
                                title="{i18n>remarks}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection
                                        id="idReportObjectPageSubSectionForm18Remarks18"
                                    >
                                        <uxap:blocks>
                                            <VBox
                                                id="idReportObjectPageSubSectionForm18RemarksVBox18"
                                            >
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Form18.Remarks"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>

                            <!-- Attachments Section -->
                            <uxap:ObjectPageSection id="idReportObjectPageSectionAttachments18"
                                title="{i18n>attachments}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection id="idReportObjectPageSubSectionAttachments18">
                                        <uxap:blocks>
                                            <VBox id="idReportObjectPageSubSectionAttachmentsVBox18">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Attachments"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                        </uxap:sections>
                    </uxap:ObjectPageLayout>
                </content>
                <footer>
                    <OverflowToolbar id="idReportOverflowToolbar18">
                        <ToolbarSpacer id="idReportToolbarSpacer18" />
                        <Button
                            id="idReportSaveBtn18"
                            text="{i18n>saveBtnText}"
                            type="Critical"
                            press="handleSaveBtnPress"
                            icon="sap-icon://save"
                            visible="{= ${viewModel>/Status} !== 'Submitted' }"
                        />
                        <Button
                            id="idReportSubmitBtn18"
                            text="{i18n>submitBtnText}"
                            type="Success"
                            press="handleSubmitBtnPress"
                            icon="sap-icon://create"
                            visible="{= ${viewModel>/Status} !== 'Submitted' }"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
