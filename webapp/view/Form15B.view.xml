<mvc:View
    controllerName="com.nhpc.zsdtarifformss1.controller.Form15B"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    class="sapUiSizeCompact"
>
    <App id="idReportApp15B">
        <pages>
            <Page
                id="idReportPage15B"
                showHeader="false"
            >
                <content>
                    <uxap:ObjectPageLayout
                        id="idReportObjectPageLayout15B"
                        upperCaseAnchorBar="false"
                    >
                        <uxap:headerTitle>
                            <uxap:ObjectPageDynamicHeaderTitle id="idReportObjectPageDynamicHeaderTitle15B">
                                <uxap:expandedHeading>
                                    <HBox id="idReportObjectPageExpandedHeading15B"
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar id="idReportObjectPageExpandedHeadingAvatar15B"
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox id="idReportObjectPageExpandedHeadingVBox15B" class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeader15B"
                                                text="{i18n>form15BPage}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus id="objPageHeaderStatus15B"
                                                title="{i18n>status}"
                                                text="{viewModel>/Status}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:expandedHeading>
                                <uxap:snappedHeading>
                                    <HBox id="idReportObjectPageSnappedHeading15B"
                                        fitContainer="true"
                                        alignItems="Center"
                                    >
                                        <Avatar id="idReportObjectPageSnappedHeadingAvatar15B"
                                            src="sap-icon://activity-items"
                                            class="sapUiTinyMarginEnd"
                                            displayShape="Square"
                                        />
                                        <VBox id="idReportObjectPageSnappedHeadingVBox15B" class="sapUiTinyMarginBegin">
                                            <Title
                                                id="objPageHeadersnapped15B"
                                                text="{i18n>form15BPage}"
                                                wrapping="true"
                                            />
                                            <ObjectStatus id="objPageHeaderStatussnapped15B"
                                                title="{i18n>status}"
                                                text="{viewModel>/Status}"
                                                class="sapMObjectStatusMedium statusBoldText"
                                                state="{path:'viewModel>/Status',formatter:'.formatter.formatStatusState'}"
                                            />
                                        </VBox>
                                    </HBox>
                                </uxap:snappedHeading>
                            </uxap:ObjectPageDynamicHeaderTitle>
                        </uxap:headerTitle>
                        <uxap:headerContent>
                            <FlexBox id="idReportObjectPageHeaderContent15B"
                                fitContainer="true"
                                wrap="Wrap"
                            />
                        </uxap:headerContent>
                        <uxap:sections>
                            <uxap:ObjectPageSection id="idReportObjectPageSectionGeneral15B"
                                title="{i18n>generalDetails}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection id="idReportObjectPageSubSectionGeneral15B">
                                        <uxap:blocks>
                                            <VBox id="idReportObjectPageSubSectionGeneralVBox15B">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Form15B.BasicDetails"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            <uxap:ObjectPageSection id="idReportObjectPageSectionForm15BDetails15B"
                                title="{i18n>form15BDetails}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection id="idReportObjectPageSubSectionForm15BDetails15B">
                                        <uxap:blocks>
                                            <VBox id="idReportObjectPageSubSectionForm15BDetailsVBox15B">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Form15B.Form15BTable"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>

                            <!-- Remarks Section -->
                            <uxap:ObjectPageSection id="idReportObjectPageSectionForm15BRemarks15B"
                                title="{i18n>remarks}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection id="idReportObjectPageSubSectionForm15BRemarks15B">
                                        <uxap:blocks>
                                            <VBox id="idReportObjectPageSubSectionForm15BRemarksVBox15B">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Form15B.Remarks"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection>
                            
                            <!-- <uxap:ObjectPageSection id="idReportObjectPageSectionAttachments15B"
                                title="{i18n>attachments}"
                                titleUppercase="false"
                            >
                                <uxap:subSections>
                                    <uxap:ObjectPageSubSection id="idReportObjectPageSubSectionAttachments15B">
                                        <uxap:blocks>
                                            <VBox id="idReportObjectPageSubSectionAttachmentsVBox15B">
                                                <core:Fragment
                                                    fragmentName="com.nhpc.zsdtarifformss1.fragments.Attachments"
                                                    type="XML"
                                                />
                                            </VBox>
                                        </uxap:blocks>
                                    </uxap:ObjectPageSubSection>
                                </uxap:subSections>
                            </uxap:ObjectPageSection> -->
                        </uxap:sections>
                    </uxap:ObjectPageLayout>
                </content>
                <footer>
                    <OverflowToolbar id="idReportOverflowToolbar15B">
                        <ToolbarSpacer id="idReportToolbarSpacer15B" />
                        <Button id="idReportSaveBtn15B"
                            text="{i18n>saveBtnText}"
                            type="Critical"
                            press="handleSaveBtnPress"
                            icon="sap-icon://save"
                            visible="{= ${viewModel>/Status} !== 'Submitted' }"
                        />
                        <Button id="idReportSubmitBtn15B"
                            text="{i18n>submitBtnText}"
                            type="Success"
                            press="handleSubmitBtnPress"
                            icon="sap-icon://create"
                            visible="{= ${viewModel>/Status} !== 'Submitted' }"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
