<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase11">
        <f:SimpleForm
            id="generalInfoFormBase11"
            editable="true"
            layout="ColumnLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/formDetails}"
        >
            <f:content>
                <Label text="{i18n>diameterShape}" required="true" />
                <Input value="{viewModel>Tail_Race_DiameterShape}" required="true" valueState="{viewModel>/valueState/Tail_Race_DiameterShape}" valueStateText="{viewModel>/valueStateText/Tail_Race_DiameterShape}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>length}" required="true" />
                <Input value="{viewModel>Tail_Race_Length}" required="true" valueState="{viewModel>/valueState/Tail_Race_Length}" valueStateText="{viewModel>/valueStateText/Tail_Race_Length}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>minimumTailWaterLevel}" required="true" />
                <Input value="{viewModel>Minimum_tail_waterlevel}" required="true" valueState="{viewModel>/valueState/Minimum_tail_waterlevel}" valueStateText="{viewModel>/valueStateText/Minimum_tail_waterlevel}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
