<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase3">
        <f:SimpleForm
            id="generalInfoFormBase3"
            editable="true"
            layout="ColumnLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/formDetails}"
        >
            <f:content>
                <Label text="{i18n>type}" required="true"/>
                <Input value="{viewModel>Dam_Type}" valueState="{viewModel>/valueState/Dam_Type}" valueStateText="{viewModel>/valueStateText/Dam_Type}" required="true" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>maximumDamHeight}" required="true"/>
                <Input value="{viewModel>Maximum_Dam_Height}" required="true" valueState="{viewModel>/valueState/Maximum_Dam_Height}" valueStateText="{viewModel>/valueStateText/Maximum_Dam_Height}"  editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}"/>
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
