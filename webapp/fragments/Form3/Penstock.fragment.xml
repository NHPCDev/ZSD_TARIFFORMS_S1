<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase9">
        <f:SimpleForm
            id="generalInfoFormBase9"
            editable="true"
            layout="ColumnLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/formDetails}"
        >
            <f:content>
                <core:Title text="{i18n>pressureShafts}"></core:Title>
                <Label text="{i18n>numberAndType}" />
                <Input value="{viewModel>Pressure_Shaft_type}" change=".onInputChange"  editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>diameterAndLength}" />
                <Input value="{viewModel>Pressure_diameter_length}" change=".onInputChange" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}"/>
                <Label text="{i18n>lengthUptoMainifold}" />
                <Input value="{viewModel>Manifold_Length}" change=".onDecimalNumberChange" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <core:Title text="{i18n>individualPenstocks}"></core:Title>
                <Label text="{i18n>numberAndType}" />
                <Input value="{viewModel>Individual_Penstocks_type}" change=".onInputChange" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>diameterAndLength}" />
                <Input value="{viewModel>Individual_Penstocks_diameter}" change=".onInputChange" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>lengthUptoMainifold}" />
                <Input value="{viewModel>Individual_Penstocks_manifold}" change=".onDecimalNumberChange" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
