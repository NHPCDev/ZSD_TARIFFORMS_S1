<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase13">
        <f:SimpleForm
            id="generalInfoFormBase13"
            editable="true"
            layout="ResponsiveGridLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/formDetails}"
        >
            <f:content>
                <Label text="{i18n>Remarks}" />
                <TextArea value="{viewModel>Remarks}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" rows="3" />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
