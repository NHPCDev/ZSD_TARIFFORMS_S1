<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase4">
        <f:SimpleForm
            id="generalInfoFormBase4"
            editable="true"
            layout="ColumnLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/formDetails}"
        >
            <f:content>
            <core:Title text="{i18n>mainSpillway}"></core:Title>
                <Label text="{i18n>type}" />
                <Input value="{viewModel>Spillway_Type}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <Label text="{i18n>crestLevelOfSpillway}" />
                <Input value="{viewModel>Crest_Level_Spillway}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
                <core:Title text="{i18n>chuteSpillway}"></core:Title>
                <Label text="{i18n>type}" />
                <Input value="{viewModel>Chute_Spillway_type}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}"/>
                <Label text="{i18n>crestLevelOfSpillway}" />
                <Input value="{viewModel>Chute_Spillway_crestlevel}" editable="{= ${viewModel>/Status} === 'NEW' || ${viewModel>/Status} === 'Draft'}" />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
