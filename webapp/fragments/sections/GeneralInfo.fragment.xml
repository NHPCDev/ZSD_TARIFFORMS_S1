<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox id="generalInfoVBoxBase">
        <f:SimpleForm
            id="generalInfoFormBase"
            editable="true"
            layout="ColumnLayout"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="true"
            binding="{viewModel>/Header}"
        >
            <f:content>

                <core:Title id="idGenInfott1Base" />

                <Label
                    id="profitCenterLabelBase"
                    text="{i18n>profitCenter}"
                />
                <Input
                    id="profitCenterInputBase"
                    value="{viewModel>Profit_Center}"
                    editable="false"
                />

                <Label
                    id="tariffPeriodLabelBase"
                    text="{i18n>tariffPeriod}"
                />
                <Input
                    id="tariffPeriodInputBase"
                    value="{viewModel>Tariff_Period}"
                    editable="false"
                />

                <Label
                    id="tariffStageLabelBase"
                    text="{i18n>tariffStage}"
                />
                <Input
                    id="tariffStageInputBase"
                    editable="false"
                     value="{ 
                       path:'viewModel>Tariff_Stage',
                       formatter:'.formatter.formatTariffStageText'
                     }"
                />

                <Label
                    id="plantStageLabelBase"
                    text="{i18n>plantStage}"
                />
                <Input
                    id="plantStageInputBase"
                    editable="false"
                    value='{viewModel>Plant_Stage}'
                />

                <Label
                    id="plantVersionLabelBase"
                    text="{i18n>Version}"
                />
                <Input
                    id="plantVersionInputBase"
                    value="{viewModel>Version}"
                    editable="false"
                />

                <Label
                    id="plantStatusLabelBase"
                    text="{i18n>status}"
                />
                <Input
                    id="plantStatusInputBase"
                    value="{viewModel>Status}"
                    editable="false"
                />

                <Label
                    text="{i18n>plant}"
                />
                <Input
                    value="{viewModel>Plant}"
                    editable="false"
                />
                <Label
                    text="{i18n>nameOfPetitioner}"
                />
                <Input
                    value="{viewModel>Company}"
                    editable="false"
                />
                <Label
                    text="{i18n>nameOfGeneratingStation}"
                />
                <Input
                    value="{viewModel>Generating_Station}"
                    editable="false"
                />
                <Label
                    text="{i18n>cod}"
                />
                <DatePicker
                    value="{viewModel>Cod}"
                    valueFormat="yyyyMMdd"
                    displayFormat="dd.MM.yyyy"
                    editable="false"
                />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>