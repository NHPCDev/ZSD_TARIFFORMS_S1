<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:unified="sap.ui.unified"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <table:Table
        id="idForm9BTable"
        rows="{viewModel>/catalog/Form9B}"
        selectionMode="None"
        visible="true"
        alternateRowColors="true"
        fixedColumnCount="1"
    >
        <table:rowMode>
            <rowmodes:Fixed
                id="_IDGenFixed2"
                rowCount="3"
                rowContentHeight="70"
            />
        </table:rowMode>
        <table:columns>
            <table:Column
                id="_IDGenColumn4"
                width="300px"
            >
                <Label
                    id="_IDGenLabel4"
                    text="{i18n>headOfWorkEquipment}"
                />
                <table:template>
                    <Text
                        id="_IDGenText4"
                        text="{viewModel>Equipment}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn5"
                width="200px"
            >
                <Label
                    id="_IDGenLabel5"
                    text="{i18n>workEquipmentAdded}"
                    wrapping="true"
                />
                <table:template>
                    <Input
                        id="_IDGenText5"
                        value="{viewModel>Equip_unit}"
                        type="Number"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn6"
                width="200px"
            >
                <Label
                    id="_IDGenLabel6"
                    text="{i18n>amountCapitalised}"
                    wrapping="true"
                />
                <table:template>
                    <Input
                        id="_IDGenText6"
                        value="{viewModel>Amount}"
                        type="Number"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn7"
                width="300px"
            >
                <Label
                    id="_IDGenLabel7"
                    text="{i18n>justificationForCapitalisationProposed}"
                    wrapping="true"
                />
                <table:template>
                    <TextArea
                        id="_IDGenText7"
                        value="{viewModel>Justification}"
                        growing="false"
                        rows="3"
                        editable="{viewModel>/canEdit}"
                        showExceededText="true"
                        width="100%"
                    />
                </table:template>
            </table:Column>
            <table:Column
                id="_IDGenColumn8"
                width="200px"
            >
                <Label
                    id="_IDGenLabel8"
                    text="{i18n>impactOnLifeExtension}"
                />
                <table:template>
                    <Input
                        id="_IDGenText8"
                        value="{viewModel>Extension}"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>
