<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:u = "sap.ui.unified"
    class="sapUiSizeCompact"
>
    <TreeTable
        id="idForm9BTable"
        rows="{
            path: 'viewModel>/catalog/Form9B',
            parameters: {
                arrayNames: ['Form9bheaditem']
            }
        }"
        selectionMode="Single"
        selectionBehavior="RowOnly"
        enableSelectAll="true"
        fixedColumnCount="2"
        class="sapUiSizeCompact"
        alternateRowColors="true"
    >
        <extension>
            <m:OverflowToolbar>
                <m:ToolbarSpacer />
                <m:Button
                    text="{i18n>DownloadBtnText}"
                    icon="sap-icon://download"
                    type="Reject"
                    press="onDownloadTemplate"
                    visible="{= ${viewModel>/Status} !== 'Submitted' }"
                />
                <u:FileUploader
                    id="fileUploader9B"
                    sameFilenameAllowed="true"
                    iconOnly="false"
                    buttonOnly="true"
                    fileType="XLSX"
                    icon="sap-icon://upload"
                    iconFirst="true"
                    change="onFileChange"
                    visible="{= ${viewModel>/Status} !== 'Submitted' }"
                    style="Accept"
                    buttonText="{i18n>uploadBtnText}"
                ></u:FileUploader>
                <m:Button
                    text="{i18n>addChild}"
                    icon="sap-icon://add"
                    type="Accept"
                    press=".onForm9BAdd"
                    visible="{= ${viewModel>/Status} !== 'Submitted' }"
                />
                <m:Button
                    text="{i18n>deleteChild}"
                    icon="sap-icon://delete"
                    type="Reject"
                    press=".onForm9BDelete"
                    visible="{= ${viewModel>/Status} !== 'Submitted' }"
                />
            </m:OverflowToolbar>
        </extension>
        <rowMode>
            <rowmodes:Fixed
                rowContentHeight="70"
                rowCount="4"
            />
        </rowMode>
        <columns>
            <Column
                width="400px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>title1}"
                    wrapping="true"
                />
                <template>
                    <m:Text
                        text="{viewModel>Text}"
                        wrapping="true"
                        class="sapUiSmallMargin statusBoldText"
                    />
                </template>
            </Column>
            <Column
                width="200px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>headOfWork}"
                    wrapping="true"
                />
                <template>
                    <m:TextArea
                        value="{viewModel>Equipment}"
                        rows="3"
                        growing="false"
                        width="100%"
                        editable="{= ${viewModel>/canEdit} &amp;&amp; ${viewModel>IsSubTotal}!== 'X' &amp;&amp; ${viewModel>IsTotal}!=='X'}"
                        visible="{= !${viewModel>Text} }"
                        valueState="{viewModel>_EquipmentState}"
                        valueStateText="{viewModel>_EquipmentStateText}"
                    />
                </template>
            </Column>
            <Column
                width="120px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>headOfAccount}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Head_Account}"
                        liveChange="onNumberInputChange"
                        editable="{= ${viewModel>/canEdit} &amp;&amp; ${viewModel>IsSubTotal}!== 'X' &amp;&amp; ${viewModel>IsTotal}!=='X'}"
                        visible="{= !${viewModel>Text} }"
                        valueState="{viewModel>_HeadAccountState}"
                        valueStateText="{viewModel>_HeadAccountStateText}"
                    />
                </template>
            </Column>
            <Column
                width="120px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>accuralBasis}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Accural_Basis}"
                        change="onDecimalNumberChange"
                        editable="{= ${viewModel>/canEdit} &amp;&amp; ${viewModel>IsSubTotal}!== 'X' &amp;&amp; ${viewModel>IsTotal}!=='X'}"
                        visible="{= !${viewModel>Text} }"
                        valueState="{viewModel>_AccuralBasisState}"
                        valueStateText="{viewModel>_AccuralBasisStateText}"
                    />
                </template>
            </Column>
            <Column
                width="140px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>unDischargedLiability}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Discharge_Liabilty}"
                        change="onDecimalNumberChange"
                        editable="false"
                        visible="{= !${viewModel>Text} }"
                    />
                </template>
            </Column>
            <Column
                width="120px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>cashBasis}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Cash_Basis}"
                        change="onDecimalNumberChange"
                        editable="false"
                        visible="{= !${viewModel>Text} }"
                    />
                </template>
            </Column>
            <Column
                width="120px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>IDCIncluded}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Idc}"
                        change="onDecimalNumberChange"
                        editable="false"
                        visible="{= !${viewModel>Text} }"
                    />
                </template>
            </Column>
            <Column
                width="150px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>regulationUnderWhichClaimed}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Regulation}"
                        editable="{= ${viewModel>/canEdit} &amp;&amp; ${viewModel>IsSubTotal}!== 'X' &amp;&amp; ${viewModel>IsTotal}!=='X'}"
                        visible="{= !${viewModel>Text} }"
                        valueState="{viewModel>_RegulationState}"
                        valueStateText="{viewModel>_RegulationStateText}"
                    />
                </template>
            </Column>
            <Column
                width="300px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>justification}"
                    wrapping="true"
                />
                <template>
                    <m:TextArea
                        value="{viewModel>Justification}"
                        rows="3"
                        growing="false"
                        width="100%"
                        editable="{= ${viewModel>/canEdit} &amp;&amp; ${viewModel>IsSubTotal}!== 'X' &amp;&amp; ${viewModel>IsTotal}!=='X'}"
                        visible="{= !${viewModel>Text} }"
                        valueState="{viewModel>_JustificationState}"
                        valueStateText="{viewModel>_JustificationStateText}"
                    />
                </template>
            </Column>
            <Column
                width="150px"
                hAlign="Center"
            >
                <m:Label
                    text="{i18n>admittedCostbyTheCommissionIfAny}"
                    wrapping="true"
                />
                <template>
                    <m:Input
                        value="{viewModel>Admitted_Cost}"
                        change="onDecimalNumberChange"
                        editable="false"
                        visible="{= !${viewModel>Text} }"
                    />
                </template>
            </Column>
        </columns>
    </TreeTable>
</core:FragmentDefinition>
