<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:unified="sap.ui.unified"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <table:Table
        id="idForm9DTable"
        rows="{viewModel>/catalog/Form9D}"
        selectionMode="None"
        visible="true"
        alternateRowColors="true"
        fixedColumnCount="1"
    >
        <table:rowMode>
            <rowmodes:Fixed
                rowCount="3"
                rowContentHeight="70"
            />
        </table:rowMode>
        <table:columns>
            <table:Column
                width="300px"
            >
                <Label
                    text="{i18n>headOfWorkEquipment}"
                />
                <table:template>
                    <Text
                        text="{viewModel>Equipment}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                width="200px"
            >
                <Label
                    text="{i18n>accuralBasis}"
                    wrapping="true"
                />
                <table:template>
                    <Input
                        value="{viewModel>Accural_Basis}"
                        type="Number"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                width="200px"
            >
                <Label
                    text="{i18n>unDischargedLiability}"
                    wrapping="true"
                />
                <table:template>
                    <Input
                        value="{viewModel>UnDischarged}"
                        type="Number"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                width="200px"
            >
                <Label
                    text="{i18n>cashBasis}"
                />
                <table:template>
                    <Input
                        value="{viewModel>CashBasis}"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                width="200px"
            >
                <Label
                    text="{i18n>IDCIncluded}"
                />
                <table:template>
                    <Input
                        value="{viewModel>IDC}"
                        editable="{viewModel>/canEdit}"
                    />
                </table:template>
            </table:Column>
            <table:Column
                width="300px"
            >
                <Label
                    text="{i18n>justification}"
                    wrapping="true"
                />
                <table:template>
                    <TextArea
                        value="{viewModel>Justification}"
                        growing="false"
                        rows="3"
                        editable="{viewModel>/canEdit}"
                        showExceededText="true"
                        width="100%"
                    />
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>
