    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:unified="sap.ui.unified"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <table:Table
        id="form9CTable"
        rows="{/catalog/Form9C}"
        selectionMode="None"
        visible="true"
        alternateRowColors="true"
        fixedColumnCount="1"
        width="100%"
